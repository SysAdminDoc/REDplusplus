<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is still present (legacy "-classic" shell + dialogs). Dropped
         once ROADMAP #2 retires the WinForms UI. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RED</RootNamespace>
    <AssemblyName>RED+</AssemblyName>
    <StartupObject>RED.Program</StartupObject>
    <ApplicationIcon>Resources\Images\iconProject.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Audit transitive NuGet dependencies for known vulnerabilities at restore. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Embed CI source paths (not local dev paths) in PDBs for reproducibility. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- WFO0003: the WinForms analyzer wants high-DPI moved out of the manifest into
         ApplicationHighDpiMode/SetHighDpiMode. That only configures WinForms; this
         app is WPF-first and WPF reads PerMonitorV2 from app.manifest (which WinForms
         also honors). Keep the manifest as the single DPI source and silence the hint. -->
    <NoWarn>WFO0003</NoWarn>

    <!-- Keep the hand-maintained Properties\AssemblyInfo.cs as the single
         version/metadata source (see CLAUDE.md "Version sync points"); the SDK
         must not also emit assembly attributes or it duplicates them. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Preserve the legacy output layout: repo-root bin\<Config>\RED+.exe with
         no TFM subfolder, so the CI safety smoke and tooling paths are unchanged
         by the migration. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>

    <!-- Required to embed the WinForms/WPF image and icon resources
         (System.Drawing Bitmap/Icon, via ResXFileRef type converters) on modern
         .NET. Unlike the old net481 build, the net9 runtime ships the matching
         System.Resources.Extensions reader in-box, so iconProject and friends now
         resolve at runtime and the GUI launches locally. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>

    <!-- Self-contained single-file publish settings (release.yml drives publish
         with -p:PublishSingleFile=true; the RID is supplied on the command line). -->
    <SelfContained Condition="'$(PublishSingleFile)' == 'true'">true</SelfContained>
    <PublishReadyToRun Condition="'$(PublishSingleFile)' == 'true'">true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Stamp the build time into a linked resource the About box reads. Mirrors
       the legacy pre-build step; writes BuildTimeRelease.txt / BuildTimeDebug.txt
       which Properties\Resources.resx embeds by reference. In CI (SOURCE_DATE_EPOCH
       set), use the commit timestamp for reproducible builds; locally use Now. -->
  <Target Name="StampBuildTime" BeforeTargets="PrepareForBuild">
    <Exec Condition="'$(SOURCE_DATE_EPOCH)' != ''"
          Command="powershell -NoProfile -Command &quot;[DateTimeOffset]::FromUnixTimeSeconds($env:SOURCE_DATE_EPOCH).UtcDateTime.ToString('yyyy-MM-ddTHH:mm:ss') | Set-Content '$(ProjectDir)Resources\BuildTime$(Configuration).txt' -NoNewline&quot;" />
    <Exec Condition="'$(SOURCE_DATE_EPOCH)' == ''"
          Command="powershell -NoProfile -Command &quot;[DateTime]::Now.ToString('yyyy-MM-ddTHH:mm:ss') | Set-Content '$(ProjectDir)Resources\BuildTime$(Configuration).txt' -NoNewline&quot;" />
  </Target>

</Project>
